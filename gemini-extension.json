{
  "name": "lark-mcp",
  "version": "1.1.0",
  "description": "A Gemini CLI & Antigravity extension for Lark Suite International MCP server (Asza Soluções Corporativas).",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "lark-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@larksuiteoapi/lark-mcp",
        "mcp",
        "-a",
        "<your_app_id>",
        "-s",
        "<your_app_secret>",
        "-d",
        "https://open.larksuite.com",
        "--oauth",
        "--token-mode",
        "auto"
      ]
    }
  }
}
